Options -Indexes

# An address that isn't there gets a Mashpad page, still with the 404 status. This is a path from the site's root, so it
# assumes Mashpad is served at the root of its domain (as mashpad.ai is); in a sub-folder Apache falls back to its own page.
ErrorDocument 404 /404.php
DirectoryIndex index.php

# Clean addresses: /pads/<owner>/<pad>, /manage/<owner>/<pad> and /mcp.
# Private pads are only reachable at these addresses, so mod_rewrite is required
# for them. Without it the rest of the site (and /mcp/ with its slash) still works.
<IfModule mod_rewrite.c>
# Pass "Authorization: Bearer <token>" through to PHP on CGI/FastCGI hosts (an invitation link is an MCP address too).
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

RewriteEngine On

# BASE = the URL path of this folder ("/" or "/message-board/"), worked out on each
# request, so the rules need no RewriteBase and work wherever the folder is mounted.
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=BASE:%1]

# /mcp with no trailing slash is answered directly. The usual redirect to /mcp/
# makes many clients repeat their POST as a GET, which breaks MCP.
RewriteRule ^mcp$ %{ENV:BASE}mcp/index.php [L]
RewriteRule ^mcp/open$ %{ENV:BASE}mcp/open/index.php [L]
# mcp/i/<invitation>: the same server, reached through an invitation, so the sign-in page already knows which pad.
RewriteRule ^mcp/i/([A-Za-z0-9]{16,64})/?$ %{ENV:BASE}mcp/index.php?invite=$1 [L,QSA]

# OAuth discovery documents, where the specs say an app will look for them.
RewriteRule ^\.well-known/oauth-(protected-resource|authorization-server)(/.*)?$ %{ENV:BASE}oauth/metadata/index.php [L]
# A client may look for OpenID Connect discovery first, at the issuer or beside the MCP address. Mashpad isn't an OpenID provider,
# so it answers with the same authorization server document (RFC 8414 allows it) rather than leave Apache to answer with a
# "Multiple Choices" page that a client can't read.
RewriteRule ^(mcp/)?\.well-known/openid-configuration(/.*)?$ %{ENV:BASE}oauth/metadata/index.php [L]

# /pads/<owner>/<pad> and /manage/<owner>/<pad> are served by pads/ and manage/.
RewriteRule ^(pads|manage)/[A-Za-z0-9][A-Za-z0-9_-]*/[A-Za-z0-9][A-Za-z0-9_-]*/?$ %{ENV:BASE}$1/index.php [L]

# /join/<token> is a pad's invite link, served by join/.
RewriteRule ^join/[A-Za-z0-9]+/?$ %{ENV:BASE}join/index.php [L]

# Any other folder asked for without its trailing slash gets the slash added.
# (This is what DirectorySlash does; it is switched off below so the /mcp rule can work.)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ %{ENV:BASE}$1/ [R=301,L]

<IfModule mod_dir.c>
DirectorySlash Off
</IfModule>
</IfModule>
